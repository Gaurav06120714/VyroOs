/*
 * Vyro Plymouth boot splash
 *
 * Renders the Vyro mark centered on a #0B0B12 background, with a soft
 * pulsing accent halo. Progress bar appears across the bottom 1/3.
 */

# --- background ---
Window.SetBackgroundTopColor(0.043, 0.043, 0.071);     /* #0B0B12 */
Window.SetBackgroundBottomColor(0.043, 0.043, 0.071);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# --- mark ---
mark.image  = Image("vyro-mark.png");
mark.sprite = Sprite(mark.image);
mark.sprite.SetX(screen_w / 2 - mark.image.GetWidth() / 2);
mark.sprite.SetY(screen_h / 2 - mark.image.GetHeight() / 2 - 40);

# --- halo (pulsing accent glow) ---
halo.image  = Image("vyro-halo.png");
halo.sprite = Sprite(halo.image);
halo.sprite.SetX(screen_w / 2 - halo.image.GetWidth() / 2);
halo.sprite.SetY(screen_h / 2 - halo.image.GetHeight() / 2 - 40);
halo.sprite.SetZ(-1);

# --- progress dots ---
dots = [];
for (i = 0; i < 5; i++) {
    img = Image("dot.png");
    s   = Sprite(img);
    s.SetX(screen_w / 2 - (5 * 24) / 2 + i * 24);
    s.SetY(screen_h / 2 + 100);
    dots[i] = s;
}

# --- animation tick ---
phase = 0;
tick_count = 0;
fun refresh_callback() {
    tick_count++;

    # halo opacity pulses sinusoidally
    t = tick_count / 30.0;
    alpha = 0.35 + 0.25 * Math.Sin(t);
    halo.sprite.SetOpacity(alpha);

    # progress dots rotate
    phase = (tick_count / 6) % 5;
    for (i = 0; i < 5; i++) {
        dots[i].SetOpacity((i == phase) ? 1.0 : 0.25);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- message ---
status_msg.sprite = Sprite();
fun message_callback(text) {
    status_msg.image = Image.Text(text, 0.91, 0.91, 0.94, 1, "Inter 11");
    status_msg.sprite.SetImage(status_msg.image);
    status_msg.sprite.SetX(screen_w / 2 - status_msg.image.GetWidth() / 2);
    status_msg.sprite.SetY(screen_h / 2 + 140);
}
Plymouth.SetMessageFunction(message_callback);

fun update_status_callback(status) { message_callback(status); }
Plymouth.SetUpdateStatusFunction(update_status_callback);

fun quit_callback() { }
Plymouth.SetQuitFunction(quit_callback);
