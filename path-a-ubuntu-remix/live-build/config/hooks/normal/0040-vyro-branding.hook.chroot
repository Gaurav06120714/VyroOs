#!/bin/sh
# vA.7.5: branding sources live at /usr/share/vyro-staging/* via includes.chroot.
# This hook rasterizes the SVGs to PNGs at the right sizes, registers Plymouth,
# appends GDM CSS, populates the Calamares branding directory, and points
# Calamares at it.

set -e

STAGE="/usr/share/vyro-staging"

# --- Plymouth assets (rasterized into the already-installed theme dir) ---
PLY_DST="/usr/share/plymouth/themes/vyro"
if command -v rsvg-convert >/dev/null 2>&1; then
    rsvg-convert -w 256 "${STAGE}/logos/vyro-mark.svg" -o "${PLY_DST}/vyro-mark.png"
fi

# vA.7.10: generate halo + dot procedurally so vyro.script's references resolve.
if [ -x "${STAGE}/scripts/make-plymouth-assets.sh" ]; then
    "${STAGE}/scripts/make-plymouth-assets.sh" "${PLY_DST}"
fi

plymouth-set-default-theme -R vyro || true

# --- GDM CSS append (idempotent) ---
GDM_CSS="/usr/share/gnome-shell/theme/gnome-shell.css"
GDM_MARK="/* vyro-gdm-css-installed */"
if [ -f "${GDM_CSS}" ] && ! grep -qF "${GDM_MARK}" "${GDM_CSS}"; then
    echo "" >> "${GDM_CSS}"
    echo "${GDM_MARK}" >> "${GDM_CSS}"
    cat "${STAGE}/gdm/vyro-gdm.css" >> "${GDM_CSS}"
fi

# --- Calamares branding ---
CAL_DST="/etc/calamares/branding/vyro"
install -d "${CAL_DST}"
cp "${STAGE}/installer/branding.desc" "${CAL_DST}/branding.desc"
cp "${STAGE}/installer/show.qml"      "${CAL_DST}/show.qml"
if command -v rsvg-convert >/dev/null 2>&1; then
    rsvg-convert -w 96  "${STAGE}/logos/vyro-mark.svg"     -o "${CAL_DST}/logo.png"
    rsvg-convert -w 360 "${STAGE}/logos/vyro-wordmark.svg" -o "${CAL_DST}/welcome.png"
fi

if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/^branding:.*/branding: vyro/' /etc/calamares/settings.conf
fi

echo "vyro-branding hook: Plymouth + GDM + Calamares wired"
