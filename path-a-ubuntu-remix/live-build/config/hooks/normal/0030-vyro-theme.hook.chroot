#!/bin/sh
# vA.7.5: theme tree is already in /usr/share/themes/Vyro/ via includes.chroot.
# This hook only sets dconf defaults so new users get the Vyro theme + dark
# color scheme on first login.

set -e

install -d /etc/dconf/db/local.d
cat > /etc/dconf/db/local.d/00-vyro <<'EOF'
[org/gnome/shell/extensions/user-theme]
name='Vyro'

[org/gnome/desktop/interface]
gtk-theme='Vyro'
color-scheme='prefer-dark'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrains Mono 11'

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
EOF

dconf update || true
echo "vyro-theme hook: dconf defaults written"
