#!/bin/sh
# Vyro OS — live-build auto/config
# Invoked by `lb config` to set the base distribution and image options.

set -e

# Architecture defaults to amd64; override with: ARCH=arm64 lb config
ARCH="${ARCH:-amd64}"

case "${ARCH}" in
    amd64)  BOOTLOADERS="grub-efi grub-pc" ;;
    arm64)  BOOTLOADERS="grub-efi"          ;;
    *)      BOOTLOADERS="grub-efi"          ;;
esac

lb config noauto \
    --mode ubuntu \
    --distribution noble \
    --architectures "${ARCH}" \
    --linux-flavours generic \
    --archive-areas "main restricted universe multiverse" \
    --debian-installer live \
    --debian-installer-gui true \
    --bootloaders "${BOOTLOADERS}" \
    --binary-images iso-hybrid \
    --iso-application "Vyro OS" \
    --iso-publisher "Vyro Project" \
    --iso-volume "Vyro OS 7.0 ${ARCH}" \
    --bootappend-live "boot=live components quiet splash" \
    "${@}"
